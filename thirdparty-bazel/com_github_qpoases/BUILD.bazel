load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "qpoases_types_h",
    outs = ["include/qpOASES/Types.hpp"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#ifndef QPOASES_TYPES_HPP' >> $@
echo '#define QPOASES_TYPES_HPP' >> $@
echo '#define __SUPPRESSANYOUTPUT__' >> $@
echo '#define __USE_SINGLE_PRECISION__' >> $@
echo '#define __ALWAYS_INITIALISE_WITH_ALL_EQUALITIES__' >> $@
echo '#define BEGIN_NAMESPACE_QPOASES  namespace qpOASES {' >> $@
echo '#define END_NAMESPACE_QPOASES    }' >> $@
echo '#define USING_NAMESPACE_QPOASES  using namespace qpOASES;' >> $@
echo '#define REFER_NAMESPACE_QPOASES  qpOASES::' >> $@
echo '#define RR( I,J )  R[(I)+nV*(J)]' >> $@
echo '#define QQ( I,J )  Q[(I)+nV*(J)]' >> $@
echo '#define TT( I,J )  T[(I)*sizeT+(J)]' >> $@
echo '#define SOLVER_NONE' >> $@
echo 'typedef long la_int_t;' >> $@
echo 'typedef unsigned long la_uint_t;' >> $@
echo 'BEGIN_NAMESPACE_QPOASES' >> $@
echo 'typedef float real_t;' >> $@
echo 'typedef int int_t;' >> $@
echo 'typedef unsigned int uint_t;' >> $@
echo 'typedef int fint_t;' >> $@
echo 'typedef int_t sparse_int_t;' >> $@
echo 'enum BooleanType{ BT_FALSE,	BT_TRUE };' >> $@
echo 'enum PrintLevel{ PL_DEBUG_ITER = -2,' >> $@
echo '	PL_TABULAR,	PL_NONE, PL_LOW, PL_MEDIUM, PL_HIGH};' >> $@
echo 'enum VisibilityStatus{VS_HIDDEN, VS_VISIBLE};' >> $@
echo 'enum QProblemStatus{' >> $@
echo '  QPS_NOTINITIALISED, QPS_PREPARINGAUXILIARYQP, QPS_AUXILIARYQPSOLVED, ' >> $@
echo '  QPS_PERFORMINGHOMOTOPY, QPS_HOMOTOPYQPSOLVED, QPS_SOLVED};' >> $@
echo 'enum HessianType{' >> $@
echo '	HST_ZERO, 	HST_IDENTITY, 	HST_POSDEF, HST_POSDEF_NULLSPACE,' >> $@
echo '	HST_SEMIDEF, HST_INDEF, HST_UNKNOWN	};' >> $@
echo 'enum SubjectToType{' >> $@
echo '	ST_UNBOUNDED, ST_BOUNDED, ST_EQUALITY, ST_DISABLED, ST_UNKNOWN};' >> $@
echo 'enum SubjectToStatus{' >> $@
echo '	ST_LOWER = -1,' >> $@
echo '	ST_INACTIVE, ST_UPPER, ST_INFEASIBLE_LOWER, ST_INFEASIBLE_UPPER, ST_UNDEFINED};' >> $@
echo 'enum SchurUpdateType{' >> $@
echo '	SUT_VarFixed, SUT_VarFreed,	SUT_ConAdded, SUT_ConRemoved, SUT_UNDEFINED};' >> $@
echo 'struct TabularOutput {' >> $@
echo '	int_t idxAddB;' >> $@
echo '	int_t idxRemB;' >> $@
echo '	int_t idxAddC;' >> $@
echo '	int_t idxRemC;' >> $@
echo '	int_t excAddB;' >> $@
echo '	int_t excRemB;' >> $@
echo '	int_t excAddC;' >> $@
echo '	int_t excRemC; };' >> $@
echo 'typedef struct {' >> $@
echo '	long numericFormat;' >> $@
echo '	long nRows;' >> $@
echo '	long nCols;' >> $@
echo '	long imaginaryPart;' >> $@
echo '	long nCharName;' >> $@
echo '} MatMatrixHeader;' >> $@
echo 'END_NAMESPACE_QPOASES' >> $@
echo '#endif' >> $@
    """,
)

cc_library(
    name = "qpoases",
    srcs = glob([
        "src/*.cpp",
    ]),
    hdrs = glob([
        "include/*.hpp",
        "include/*.ipp",
        "include/**/*.hpp",
        "include/**/*.ipp",
        "include/qpOASES/Types.hpp",
    ]),
    include_prefix = "qpOASES",
    includes = ["include"],
    visibility = ["//visibility:public"],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
        "-fPIC",
    ],
)