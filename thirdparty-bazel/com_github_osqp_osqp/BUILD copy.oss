load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "osqp_configure_h",
    outs = ["include/osqp_configure.h"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#define IS_LINUX true'  >> $@ && \
echo '#define DFLOAT true'  >> $@
""",
)

cc_library(
    name = "osqp",
    srcs = [
        "lin_sys/direct/qdldl/qdldl_interface.c",
        "lin_sys/direct/qdldl/qdldl_interface.h",
        "src/auxil.c",
        "src/cs.c",
        "src/error.c",
        "src/kkt.c",
        "src/lin_alg.c",
        "src/lin_sys.c",
        "src/osqp.c",
        "src/polish.c",
        "src/proj.c",
        "src/scaling.c",
        "src/util.c",
    ] + glob(["lin_sys/direct/qdldl/amd/src/*.c"]),
    hdrs = [
        "include/auxil.h",
        "include/constants.h",
        "include/cs.h",
        "include/error.h",
        "include/glob_opts.h",
        "include/kkt.h",
        "include/lin_alg.h",
        "include/lin_sys.h",
        "include/osqp.h",
        "include/osqp_configure.h",
        "include/polish.h",
        "include/proj.h",
        "include/scaling.h",
        "include/types.h",
        "include/util.h",
        "include/version.h",
    ] + glob(["lin_sys/direct/qdldl/amd/include/*.h"]),
    includes = [
        "include",
        "lin_sys/direct/qdldl",
        "lin_sys/direct/qdldl/amd/include",
    ],
    deps = [
        "@com_github_osqp_qdldl//:qdldl",
    ],
)
