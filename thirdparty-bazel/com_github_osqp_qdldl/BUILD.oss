load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "qdldl_types_h",
    outs = ["include/qdldl_types.h"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#ifndef QDLDL_TYPES_H' >> $@
echo '# define QDLDL_TYPES_H' >> $@
echo '# ifdef __cplusplus' >> $@
echo 'extern "C" {' >> $@
echo '# endif /* ifdef __cplusplus */' >> $@
echo '#include <limits.h> //for the QDLDL_INT_TYPE_MAX' >> $@
echo 'typedef int QDLDL_int;   /* for indices */' >> $@
echo 'typedef double QDLDL_float; /* for numerical values  */' >> $@
echo 'typedef unsigned char QDLDL_bool;  /* for boolean values  */' >> $@
echo '#define QDLDL_INT_MAX INT_MAX' >> $@
echo '# ifdef __cplusplus' >> $@
echo '}' >> $@
echo '# endif /* ifdef __cplusplus */' >> $@
echo '#endif /* ifndef QDLDL_TYPES_H */' >> $@
""",
)

cc_library(
    name = "qdldl_types",
    hdrs = [":qdldl_types_h"],
    include_prefix = "qdldl",
)

genrule(
    name = "qdldl_version_h",
    outs = ["include/qdldl_version.h"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#ifndef QDLDL_VERSION_H_' >> $@
echo '#define QDLDL_VERSION_H_' >> $@
echo '#endif // #ifndef QDLDL_VERSION_H_' >> $@
""",
)

cc_library(
    name = "qdldl_version",
    hdrs = [":qdldl_version_h"],
    include_prefix = "qdldl",
)

cc_library(
    name = "qdldl",
    srcs = [
        "src/qdldl.c",
    ],
    hdrs = [
        "include/qdldl.h",
        "include/qdldl_types.h",
        "include/qdldl_version.h",
    ],
    strip_include_prefix = "include",
    deps = [
        ":qdldl_types",
        ":qdldl_version",
    ],
)
