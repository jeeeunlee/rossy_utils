load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "osqp_eigen_debug_h",
    outs = ["include/OsqpEigen/Debug.hpp"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#ifndef OSQPEIGEN_DEBUG_HPP'  >> $@ 
echo '#define OSQPEIGEN_DEBUG_HPP'  >> $@ 
echo '#define OSQP_EIGEN_DEBUG_OUTPUT'  >> $@ 
echo '#include <iostream>'  >> $@ 
echo 'namespace OsqpEigen { std::ostream &debugStream(); }'  >> $@ 
echo '#endif /* OSQPEIGEN_DEBUG_HPP */'  >> $@ 
""",
)



cc_library(
    name = "osqp_eigen",
    srcs = glob([
        "src/*.cpp",
    ]),
    hdrs = glob([
        "include/OsqpEigen/*.h",
        "include/OsqpEigen/*.hpp",
        "include/OsqpEigen/*.tpp",
    ]),
    strip_include_prefix = "include",
    deps = [
        "@com_github_osqp_osqp//:osqp",
        "@eigen",
    ],
)
