load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "osqp_eigen",
    srcs = glob([
        "src/*.cpp",
    ]),
    hdrs = glob([
        "include/OsqpEigen/*.h",
        "include/OsqpEigen/*.hpp",
        "include/OsqpEigen/*.tpp",
    ]),
    strip_include_prefix = "include",
    deps = [
        "@com_github_osqp_osqp//:osqp",
        "@eigen",
    ],
)
