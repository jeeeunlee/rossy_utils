
package(default_visibility = ["//visibility:public"])

load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

genrule(
    name = "osqp_configure_h",
    outs = ["include/osqp_configure.h"],
    cmd = """
echo '//auto generated by BUILD.bazel' > $@ && \
echo '#define IS_LINUX true'  >> $@
""",
)

# Filegroup for OSQP sources
filegroup(
    name = "osqp_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "osqp_hdrs",
    srcs = glob([
        "include/*.h",
        "lin_sys/direct/qdldl/*.h",
        "lin_sys/direct/qdldl/amd/include/*.h",
    ]),
    visibility = ["//visibility:public"],
)


cmake(
    name = "osqp",
    lib_source = ":osqp_srcs",
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "OSQP_FLOAT": "ON",  # Enable single precision
        "BUILD_SHARED_LIBS": "ON",
        "ENABLE_QDLDL": "ON",
    },
    deps = [
        "@com_github_osqp_qdldl//:qdldl",
    ],
    visibility = ["//visibility:public"],
    out_include_dir = "include",
    out_static_libs = ["libosqp.a"],
    out_shared_libs = ["libosqp.so"],
)
